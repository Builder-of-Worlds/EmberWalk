{
  "name": "emberwalk-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "account_id": "755646338ba02dbe2d3409c5a557fa15",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emberwalk-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberwalk-db",
      "database_id": "2a57e3df-79dd-4886-adfb-ef2967b95bf6",
      "migrations_dir": "../../migrations"
    }
  ],
  "workflows": [{ "name": "walk-pipeline", "binding": "PIPELINE", "class_name": "WalkPipeline" }],
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "../../containers/media/Dockerfile",
      "image_build_context": "../../containers/media",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": { "bindings": [{ "name": "MEDIA_CONTAINER", "class_name": "MediaContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaContainer"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "R2_HOST": "755646338ba02dbe2d3409c5a557fa15.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "emberwalk-media",
    "META_BASE_URL": "https://api.meta.ai/v1",
    "META_BILLING": "free_credits",
    "VOICE_NOTES": "on",
    "SECOND_CHECK_REAL_WALKS": "off",
    "SYNTHETIC_RENDERS": "abe7d134979368919853a540178d4c47995b2f013fa19172f06ebb70c3534419:22576900,0fc10ef76ffe5c8bbeb83bf3ae617ce63c3dd1d5b59b564fadf3132da95a7ca0:25809527,6fef74b3d8918d6c6114520b90c777646a1c8b64aa95729659d1cc6f219928b9:4312727,66f453712b91b22efb348724d193dede1eecfd95b85aeaf81092f3d09ec01549:343374474,fcd8492f1ef53971c11d8bb1870fe940b76af5df2130b2d95817a52de10fa7bd:242290505,97dff020684912a50835fc02413d5643513862dad67cc1d8cca7d6d6748cf5f0:311570372,1262cabf8a1a5fd43e272f7e30f031e999163958380a8bd1d6c15f677fd1e556:312802961,478cae7ab7adc8589254878b36bc4ecb4845312a8f570c27ba5f02c6dcb326fd:536287494,ecc35c52364d8794c7d38598a5652329021da58477481ce11b530671e89cfcac:522610532"
  }
}
