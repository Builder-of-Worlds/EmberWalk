{
  "name": "emberwalk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "account_id": "755646338ba02dbe2d3409c5a557fa15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "go.emberwalk.app", "custom_domain": true }],
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emberwalk-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberwalk-db",
      "database_id": "2a57e3df-79dd-4886-adfb-ef2967b95bf6",
      "migrations_dir": "../../migrations"
    }
  ],
  "services": [
    { "binding": "PIPELINE_SERVICE", "service": "emberwalk-pipeline", "entrypoint": "PipelineEntry" },
    { "binding": "GET_FIXED", "service": "emberwalk-getfixed", "entrypoint": "GetFixed" }
  ],
  "vars": {
    "R2_HOST": "755646338ba02dbe2d3409c5a557fa15.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "emberwalk-media"
  }
}
