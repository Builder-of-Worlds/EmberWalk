{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmberWalk OpenArt look of one synthetic sample house",
  "description": "Every OpenArt still generated for the house's look, with its credits, its original in ~/emberwalk-renders/<scene>/ by file name, size and sha256, and the owner's pick of one still per view with its committed copy. reference.kind is board, blender_frame (with frame, 1 based), still (with file, the original of another still in this file) or none; nothing else is a reference. One creation may give several stills; each original is listed once. credits_total is the sum of every still's credits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "label", "scene", "front_side", "credits_total", "stills"],
  "properties": {
    "schema": {"const": "emberwalk.openart-look/1"},
    "synthetic": {"const": true},
    "label": {"const": "Synthetic sample house"},
    "scene": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "front_side": {"type": "string", "pattern": "^[a-z]+(_[a-z]+)*$"},
    "credits_total": {"type": "number"},
    "stills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view", "creation_id", "model", "prompt", "reference", "credits", "original"],
        "properties": {
          "view": {"enum": ["front", "east", "west", "north", "after_front"]},
          "creation_id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 10},
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"type": "string"},
              "frame": {"type": "integer", "minimum": 1},
              "file": {"type": "string", "minLength": 1}
            }
          },
          "credits": {"type": "number"},
          "original": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "bytes", "sha256"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string"}
            }
          },
          "chosen": {"type": "boolean"},
          "picked_by": {"type": "string"},
          "picked_on": {"type": "string"},
          "copy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "bytes", "sha256"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
