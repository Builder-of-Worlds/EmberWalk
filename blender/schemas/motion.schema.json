{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmberWalk phone style motion file for a rendered walk: one camera pose per frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "label", "scene", "fps", "frame_count", "duration_s", "camera", "conventions", "samples"],
  "properties": {
    "schema": {"const": "emberwalk.motion/1"},
    "synthetic": {"const": true},
    "label": {"const": "Synthetic sample house"},
    "scene": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "fps": {"enum": [15, 24, 25, 30, 60]},
    "frame_count": {"type": "integer", "minimum": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "focal_mm", "sensor_width_mm", "sensor_fit", "hfov_deg", "vfov_deg"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "focal_mm": {"type": "number", "exclusiveMinimum": 0},
        "sensor_width_mm": {"type": "number", "exclusiveMinimum": 0},
        "sensor_fit": {"const": "horizontal"},
        "hfov_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "vfov_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180}
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pos_in", "heading_deg", "tilt_deg", "roll_deg", "t"],
      "properties": {
        "pos_in": {"type": "string"},
        "heading_deg": {"type": "string"},
        "tilt_deg": {"type": "string"},
        "roll_deg": {"type": "string"},
        "t": {"type": "string"}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "t", "pos_in", "heading_deg", "tilt_deg", "roll_deg"],
        "properties": {
          "frame": {"type": "integer", "minimum": 1},
          "t": {"type": "number", "minimum": 0},
          "pos_in": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "heading_deg": {"type": "number", "minimum": 0, "maximum": 360},
          "tilt_deg": {"type": "number", "minimum": -90, "maximum": 90},
          "roll_deg": {"type": "number", "minimum": -180, "maximum": 180}
        }
      }
    }
  }
}
